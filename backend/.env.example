DATABASE_URL=postgresql://postgres:password@db:5432/dealflow
SECRET_KEY=your-super-secret-key-please-change
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

SENDGRID_API_KEY=

# Google Ads Integration Configuration
# Get these from Google Ads Developer Console
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_API_KEY=your-google-ads-api-key

# Google Ads Webhook Secret
# Set this to the webhook secret provided by Google
GOOGLE_ADS_WEBHOOK_SECRET=your-webhook-secret

# Google Ads Sync Interval (in minutes)
GOOGLE_ADS_SYNC_INTERVAL_MINUTES=15

# SharePoint / Graph API
SHAREPOINT_SITE_ID=your-sharepoint-site-id

# S3 Buckets
AWS_S3_DOCUMENTS_BUCKET=dealflow-documents-yourcompany
